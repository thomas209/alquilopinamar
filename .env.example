# Copiar a ".env" (cp .env.example .env). Este archivo es SOLO para la base LOCAL.
# La URL de produccion nunca va aca: va en .env.prod-db (ver docs/base-de-datos.md).
# Formato: postgresql://USUARIO@localhost:PUERTO/alquilopinamar_dev
# USUARIO = tu usuario de la Mac. PUERTO = el de Postgres.app (5432, o 5433 si ese ya estaba ocupado).
DATABASE_URL="postgresql://USUARIO@localhost:5432/alquilopinamar_dev"

NEXT_PUBLIC_URL="http://localhost:3000"

# Login del admin (NextAuth). Generar el secreto con: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Cloudinary (fotos). Todo se sube adentro de la carpeta CLOUDINARY_FOLDER.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_FOLDER="alquilopinamar"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# WhatsApp del sitio: se usa en las fichas que no tienen numero propio.
# Solo numeros, con codigo de pais y sin el 15. Ej: 5492254123456
NEXT_PUBLIC_WHATSAPP=""

# Mails (Resend). Sin estas variables las consultas se guardan igual, pero no llega el aviso.
# RESEND_API_KEY: resend.com → API Keys. ADMIN_EMAIL: a quien le llegan los avisos (varios separados por coma).
# Sin dominio verificado en Resend, ADMIN_EMAIL tiene que ser el mail con el que se creo la cuenta.
RESEND_API_KEY=""
ADMIN_EMAIL=""
# Opcional, cuando haya dominio verificado: "AlquiloPinamar <avisos@dominio.com.ar>"
RESEND_FROM_EMAIL=""
