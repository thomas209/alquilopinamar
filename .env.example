# Copiar a ".env" (cp .env.example .env). Este archivo es SOLO para la base LOCAL.
# La URL de produccion nunca va aca: va en .env.prod-db (ver docs/base-de-datos.md).
# Formato: postgresql://USUARIO@localhost:PUERTO/alquilopinamar_dev
# USUARIO = tu usuario de la Mac. PUERTO = el de Postgres.app (5432, o 5433 si ese ya estaba ocupado).
DATABASE_URL="postgresql://USUARIO@localhost:5432/alquilopinamar_dev"

NEXT_PUBLIC_URL="http://localhost:3000"

# Login del admin (NextAuth). Generar el secreto con: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
