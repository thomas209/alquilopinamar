{
  "name": "alquilopinamar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/db-guard.mjs && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "node scripts/db-guard.mjs && prisma migrate dev",
    "db:studio": "node scripts/db-guard.mjs && prisma studio",
    "db:backup": "node scripts/db-backup.mjs",
    "db:copy-to-local": "node scripts/db-copy-prod-to-local.mjs",
    "db:deploy-prod": "node scripts/db-deploy-prod.mjs",
    "db:seed": "node scripts/db-guard.mjs && node prisma/seed.mjs",
    "admin:crear": "node scripts/db-guard.mjs && node scripts/crear-admin.mjs"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@react-email/components": "^1.0.12",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "next": "16.3.8",
    "next-auth": "^4.24.15",
    "prisma": "5.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.32.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "pg": "^8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
